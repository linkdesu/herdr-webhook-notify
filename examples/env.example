# Copy to the plugin config directory as .env:
#   herdr plugin config-dir herdr-webhook-notify
#
# Every ${NAME} used in config.toml is resolved from this file or the process
# environment. Values here win only when the variable is not already set.

FEISHU_WEBHOOK=
FEISHU_SECRET=
LARK_WEBHOOK=
LARK_SECRET=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECOM_KEY=
SLACK_WEBHOOK=
DISCORD_WEBHOOK=
TEAMS_WEBHOOK=
GOOGLE_CHAT_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
GENERIC_WEBHOOK_URL=

# Owner routes: CTO_WAKE_HEADER is one full "Name: value" line, e.g.
# CTO_WAKE_HEADER=Authorization: Bearer <token>
CTO_WAKE_URL=
CTO_WAKE_HEADER=
